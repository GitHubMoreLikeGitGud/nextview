 "traffic_note": "Before the entry was published (27 Oct 2026), all traffic was the author's own testing: deploy smoke tests, load tests at up to 10 concurrent clients against a 2 req/s stage throttle and a concurrency cap of 5, sequential latency runs and UI walkthroughs. The 429 and 503 responses come from the load tests.",
 "notes": [
  "Latency fields are the handler's own latency_ms.total (server side); Lambda REPORT durations include the runtime overhead around the handler.",
  "gb_s is sum(billedDuration x memorySize); for container images the billed duration includes init.",
  "API Gateway 4xx includes the stage throttle's 429s, which never reach Lambda; Lambda Throttles are the concurrency cap's 503s."
 ],
 "queries": {
  "lambda_report": "filter @type = \"REPORT\"\n| stats count(*) as invocations, pct(@duration, 50) as p50_ms, pct(@duration, 95) as p95_ms, max(@duration) as max_ms, count(@initDuration) as cold_starts, avg(@initDuration) as init_avg_ms, max(@initDuration) as init_max_ms, sum(@billedDuration * @memorySize) / 1000 / 1073741824 as gb_s, max(@maxMemoryUsed) / 1048576 as max_memory_mb",
  "routes_200": "filter ispresent(route) and ispresent(latency_ms.total) and status = 200\n| stats count(*) as n, pct(latency_ms.total, 50) as p50_ms, pct(latency_ms.total, 95) as p95_ms, max(latency_ms.total) as max_ms by route, mode\n| sort n desc",
  "status_counts": "filter ispresent(route) and ispresent(status)\n| stats count(*) as n by status\n| sort status asc",
  "non_200": "filter ispresent(route) and status != 200\n| stats count(*) as n by status, error, route\n| sort n desc\n| limit 40",
  "handler_exceptions": "filter evt = \"error\"\n| stats count(*) as n by error, route\n| sort n desc",
  "platform_failures": "filter @message like /Task timed out|Runtime\\.[A-Za-z]+Error|Runtime\\.OutOfMemory|Process exited before completing/\n| parse @message /(?<failure>Task timed out|Runtime\\.[A-Za-z]+|Process exited before completing)/\n| stats count(*) as n by failure",
  "cold_by_route": "filter ispresent(route) and ispresent(cold)\n| stats count(*) as n by route, cold\n| sort n desc",
  "init_warm": "filter evt = \"init_warm\"\n| stats count(*) as n, pct(ms, 50) as p50_ms, max(ms) as max_ms, count(error) as failed",
  "nbv_sim": "filter evt = \"step\" and mode = \"sim\" and status = 200 and ispresent(latency_ms.nbv)\n| stats count(*) as n, pct(latency_ms.nbv, 50) as p50_ms, pct(latency_ms.nbv, 95) as p95_ms, max(latency_ms.nbv) as max_ms, pct(n_candidates, 50) as candidates_p50, min(n_candidates) as candidates_min",
  "rules": "filter evt = \"step\" and status = 200\n| stats count(*) as n by rule\n| sort n desc"
 },
